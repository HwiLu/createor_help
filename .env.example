# ===== 运行环境 =====
# 可选值: development / production / test
APP_ENV=development

# 应用密钥（生产环境必须设置为强随机值，勿使用本占位值）
APP_SECRET_KEY=change-me-to-a-long-random-string

# ===== 数据库 =====
# 本地开发默认使用 SQLite；生产环境使用 MySQL（见 docker-compose.yml）
# MySQL 示例: mysql+pymysql://creatorhub:creatorhub@db:3306/creatorhub?charset=utf8mb4
DATABASE_URL=sqlite:///./creatorhub.db

# ===== 微信开放平台（网站应用）=====
# 未配置 AppID 时，开发环境可显式开启 Mock 登录；生产环境禁止 Mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/v1/auth/wechat/callback

# ===== 上传与证据 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# ===== 会话 Cookie =====
# 生产环境必须设置为 true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ===== Mock 登录（仅限开发环境）=====
# 生产环境无论此值如何，都会被强制禁用
MOCK_LOGIN_ENABLED=false

# ===== SMTP 邮件通知（意见反馈通知管理员）=====
# 密码仅从环境变量读取，绝不写入源码、数据库或返回前端。
# 未配置 SMTP_HOST / SMTP_USERNAME 时，邮件功能视为未启用，反馈提交不会发送邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# ===== 管理员初始化 =====
# 首个管理员通过脚本 scripts/create_admin.py 创建，无需在此配置

# ===== 反馈邮件业务配置 =====
# 反馈接收邮箱与邮件开关也可在后台「系统设置」中配置（无需写入 .env）
# 以下为进程内默认值（若后台配置了同名项，以后台为准）
FEEDBACK_RATE_LIMIT_SECONDS=30
MAX_EMAIL_RETRY=3
HOME_FEATURED_ACTIVITIES=6
